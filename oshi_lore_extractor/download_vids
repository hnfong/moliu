#!/usr/bin/env python

import sys
import glob
import subprocess
import os

DOWNLOAD_DIR="downloads/"

try:
    os.makedirs(DOWNLOAD_DIR)
except FileExistsError:
    pass

# Read YouTube URLs
urls = open(sys.argv[1]).read().strip().split('\n')

# Process each URL
for url in urls:
    url = url.strip()
    if not url:
        continue

    # Extract video ID from URL (after v=)
    video_id = url.split('v=')[-1].split('&')[0]

    # Define output filename pattern
    output_pattern = f"{video_id}.%(ext)s"

    # Check if file already exists (any audio format)
    existing_files = glob.glob(f"{video_id}.*")
    if existing_files:
        print(f"Skipping {url}: file already exists")
        continue

    # Download audio only using yt-dlp
    try:
        print(f"Downloading: {url}")
        subprocess.run([
            'yt-dlp',
            '-f', 'bestaudio',
            '--audio-format', 'mp3',
            '-o', DOWNLOAD_DIR + os.path.sep + output_pattern,
            url
        ], check=True)
        print(f"Downloaded: {url}")
    except subprocess.CalledProcessError as e:
        print(f"Failed to download {url}: {e}")
